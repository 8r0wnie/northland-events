{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc_sync_reminder.py\"",
            "timeout": 20,
            "statusMessage": "Checking doc sync"
          }
        ]
      }
    ]
  }
}
